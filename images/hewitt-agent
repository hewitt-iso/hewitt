#!/usr/bin/env bash
set -euo pipefail

export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
if [ -z "${TERM:-}" ] || [ "${TERM:-}" = "screen" ] || [ "${TERM:-}" = "dumb" ]; then
	export TERM=xterm-256color
fi
export COLORTERM="${COLORTERM:-truecolor}"

# SELF is this script. Hewitt mounts its own copy, which need not be the one
# on PATH, so the script starts itself by path.
SELF="$0"

TOOLS_DIR="${HEWITT_TOOLS_DIR:-/hewitt/tools}"
BIN_DIR="$TOOLS_DIR/bin"
export PATH="$BIN_DIR:$PATH"

# Sessions run as the host UID, which the image usually lacks; ssh refuses to
# run without a passwd entry. nss_wrapper supplies one without touching /etc.
if ! getent passwd "$(id -u)" >/dev/null 2>&1 && [ -z "${NSS_WRAPPER_PASSWD:-}" ]; then
	NSS_WRAPPER_PASSWD="$(mktemp /tmp/hewitt-passwd.XXXXXX)"
	NSS_WRAPPER_GROUP="$(mktemp /tmp/hewitt-group.XXXXXX)"
	cat /etc/passwd >"$NSS_WRAPPER_PASSWD"
	printf 'hewitt:x:%s:%s:Hewitt:%s:/bin/bash\n' "$(id -u)" "$(id -g)" "${HOME:-/tmp}" >>"$NSS_WRAPPER_PASSWD"
	cat /etc/group >"$NSS_WRAPPER_GROUP"
	getent group "$(id -g)" >/dev/null 2>&1 || printf 'hewitt:x:%s:\n' "$(id -g)" >>"$NSS_WRAPPER_GROUP"
	export NSS_WRAPPER_PASSWD NSS_WRAPPER_GROUP LD_PRELOAD="libnss_wrapper.so${LD_PRELOAD:+ $LD_PRELOAD}"
fi

# decode_args reads arguments that Hewitt passes as NUL-terminated strings
# in base64, since environment entries cannot hold arbitrary bytes, into ARGS.
decode_args() {
	ARGS=()
	local arg
	while IFS= read -r -d '' arg; do
		ARGS+=("$arg")
	done < <(printf '%s' "$1" | base64 -d)
}

# publish atomically replaces an executable in BIN_DIR. Running agents keep
# their open file; new runs use the replacement. Hewitt checks for the final
# name to decide that an installation is complete, so it is moved last.
publish() {
	local name="$1" source="$2" tmp
	tmp="$BIN_DIR/.$name.$$"
	cp -L "$source" "$tmp"
	chmod 0755 "$tmp"
	mv -f "$tmp" "$BIN_DIR/$name"
}

# install_tool installs the agent that HEWITT_INSTALL describes into the tool
# cache: an npm package, or an install script run with a temporary home that
# leaves the executable at a path inside it.
install_tool() {
	if [ -z "${HEWITT_INSTALL:-}" ]; then
		printf 'hewitt-agent install needs HEWITT_INSTALL from Hewitt\n' >&2
		return 2
	fi
	decode_args "$HEWITT_INSTALL"
	local kind="${ARGS[0]}" binary="${ARGS[1]}"
	if [ -x "$BIN_DIR/$binary" ]; then
		return 0
	fi
	mkdir -p "$BIN_DIR"
	printf 'Installing %s...\n' "$binary" >&2
	case "$kind" in
	npm)
		npm install --prefix "$TOOLS_DIR/$binary" "${ARGS[@]:3}" "${ARGS[2]}" >&2
		ln -sfn "$TOOLS_DIR/$binary/node_modules/.bin/$binary" "$BIN_DIR/.$binary.$$"
		mv -f "$BIN_DIR/.$binary.$$" "$BIN_DIR/$binary"
		;;
	script)
		local tmp url="${ARGS[2]}" output="${ARGS[3]}"
		tmp="$(mktemp -d)"
		local -a args=("${ARGS[@]:4}")
		args=("${args[@]//\{tmp\}/$tmp}")
		mkdir -p "$(dirname "$tmp/$output")"
		curl -fsSL "$url" -o "$tmp/install.sh"
		(cd "$tmp" && HOME="$tmp" bash "$tmp/install.sh" "${args[@]}" >&2)
		publish "$binary" "$tmp/$output"
		rm -rf "$tmp"
		;;
	*)
		printf 'Unknown installation kind: %s\n' "$kind" >&2
		return 1
		;;
	esac
}

# launch_args puts the command line of a launch into ARGS: HEWITT_LAUNCH for
# the agent Hewitt chose, or the menu's launch of agent $1. The marker in
# HEWITT_WORKDIR_MARK becomes the directory the agent starts in.
launch_args() {
	local spec="${HEWITT_LAUNCH:-}" mark="${HEWITT_WORKDIR_MARK:-}"
	if [ -n "${1:-}" ]; then
		local var
		var="HEWITT_LAUNCH_$(printf '%s' "$1" | tr 'a-z-' 'A-Z_')"
		spec="${!var:-}"
		var="${var}_MARK"
		mark="${!var:-}"
	fi
	if [ -z "$spec" ]; then
		printf 'hewitt: no launch for %s; this image needs a matching hewitt (hewitt run on the host starts agents)\n' "${1:-the agent}" >&2
		exit 2
	fi
	decode_args "$spec"
	if [ -n "$mark" ]; then
		ARGS=("${ARGS[@]//"$mark"/$PWD}")
	fi
	unset HEWITT_LAUNCH HEWITT_WORKDIR_MARK HEWITT_SLASH
	local name
	for name in $(compgen -e HEWITT_LAUNCH_); do unset "$name"; done
}

# exec_launch starts a launch once a container tmux client, if any, attached,
# so terminal background and palette queries reach the host terminal.
exec_launch() {
	if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
		local tries=0
		while [ "$tries" -lt 20 ] && [ -z "$(tmux list-clients 2>/dev/null)" ]; do
			sleep 0.05
			tries=$((tries + 1))
		done
	fi
	printf '[hewitt] Launching %s...\n' "${choice:-agent}" >&2
	exec "${ARGS[@]}"
}

# slash starts the launch in a private tmux server, types HEWITT_SLASH (such
# as /login) once the screen settles, and attaches to it, for agents whose
# login exists only inside their interface.
slash() {
	local command="${HEWITT_SLASH:-}" socket="/tmp/hewitt-slash-$$.sock"
	if [ -z "$command" ]; then
		printf 'hewitt-agent slash needs HEWITT_SLASH from Hewitt\n' >&2
		exit 2
	fi
	unset HEWITT_SLASH
	tmux -u -f /dev/null -S "$socket" new-session -d -s slash -x "$(tput cols 2>/dev/null || echo 120)" -y "$(tput lines 2>/dev/null || echo 40)" -- "$SELF" launch
	# Wait until the screen has been unchanged for a second (startup finished).
	local previous="" current i stable=0
	for ((i = 0; i < 240 && stable < 2; i++)); do
		sleep 0.5
		current="$(tmux -S "$socket" capture-pane -p -t slash 2>/dev/null)" || exit 1
		if [ -n "${current//[[:space:]]/}" ] && [ "$current" = "$previous" ]; then
			stable=$((stable + 1))
		else
			stable=0
		fi
		previous="$current"
	done
	# Typing a command opens completion; the first Enter may only pick the
	# completion, so press it again while the command is still in the editor.
	tmux -S "$socket" send-keys -t slash -l "$command"
	for ((i = 0; i < 3; i++)); do
		sleep 0.5
		tmux -S "$socket" send-keys -t slash Enter
		sleep 1
		tmux -S "$socket" capture-pane -p -t slash 2>/dev/null | grep -qx "[[:space:]]*$command[[:space:]]*" || break
	done
	exec env -u TMUX tmux -u -S "$socket" attach-session -t slash
}

create_worktree_if_needed() {
	if [ "${HEWITT_WORKSPACE_MODE:-worktree}" != "worktree" ]; then
		return 0
	fi
	if [ -n "${HEWITT_INITIAL_WORKTREE_READY:-}" ]; then
		unset HEWITT_INITIAL_WORKTREE_READY
		return 0
	fi
	if [ -z "${HEWITT_REPO:-}" ] || [ -z "${HEWITT_WORKTREES_DIR:-}" ]; then
		return 0
	fi
	local wt_path branch base="${HEWITT_BASE:-HEAD}"
	# A batch task names its branch; Hewitt validated the name on the host.
	local label="${HEWITT_TASK:-${choice:-agent}}" n=1
	mkdir -p "$HEWITT_WORKTREES_DIR"
	while :; do
		branch="$label-$n"
		wt_path="$HEWITT_WORKTREES_DIR/$branch"
		if [ ! -e "$wt_path" ] && ! git -C "$HEWITT_REPO" show-ref --verify --quiet "refs/heads/$branch"; then
			if git -C "$HEWITT_REPO" worktree add -b "$branch" -- "$wt_path" "$base" >&2; then
				printf '[hewitt] Branch %s\n' "$branch" >&2
				break
			fi
			# Another host terminal may have claimed this branch since our check.
			if ! git -C "$HEWITT_REPO" show-ref --verify --quiet "refs/heads/$branch"; then
				return 1
			fi
		fi
		n=$((n + 1))
	done
	local target="$wt_path"
	if [ -n "${HEWITT_SUBDIR:-}" ] && [ "$HEWITT_SUBDIR" != "." ]; then
		target="$wt_path/$HEWITT_SUBDIR"
	fi
	cd "$target"
}

exec_shell() {
	local dir_name project_root rcfile profile_home
	dir_name="${HEWITT_PROJECT_NAME:-$(basename "$PWD")}"
	project_root="$(realpath "$PWD")"
	profile_home="${HEWITT_PROFILES_DIR:-/hewitt/profiles}/claude/home"
	if [ ! -d "$profile_home" ] && [ -d "/hewitt/profile/home" ]; then
		profile_home="/hewitt/profile/home"
	fi
	if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
		tmux rename-window "shell:$dir_name" 2>/dev/null || true
	fi
	rcfile="$(mktemp /tmp/hewitt-bashrc.XXXXXX)"
	cat >"$rcfile" <<EOF
rm -f "$rcfile"
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export LESS='-R'
if [ -f /etc/bash.bashrc ]; then
	. /etc/bash.bashrc
fi
if [ -f /usr/share/bash-completion/bash_completion ]; then
	. /usr/share/bash-completion/bash_completion
fi
if command -v dircolors >/dev/null 2>&1; then
	eval "\$(dircolors -b)"
fi
export HEWITT_PROJECT_ROOT="$project_root"
export HEWITT_PROJECT_NAME="$dir_name"
export HOME="\$HEWITT_PROJECT_ROOT"
bind 'set input-meta on' 2>/dev/null || true
bind 'set output-meta on' 2>/dev/null || true
bind 'set convert-meta off' 2>/dev/null || true

alias ls='ls --color=auto'
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'

_hewitt_rel_pwd() {
	if [ "\$PWD" = "\$HEWITT_PROJECT_ROOT" ]; then
		printf '%s' "\$HEWITT_PROJECT_NAME"
	elif [[ "\$PWD" == "\$HEWITT_PROJECT_ROOT/"* ]]; then
		printf '%s/%s' "\$HEWITT_PROJECT_NAME" "\${PWD#"\$HEWITT_PROJECT_ROOT/"}"
	else
		printf '%s' "\$(basename "\$PWD")"
	fi
}

_hewitt_git_branch() {
	local br
	br="\$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)" || return 0
	if [ -n "\$br" ]; then
		printf ' (\001\033[33m\002%s\001\033[0m\002)' "\$br"
	fi
}

PS1='[\001\033[1;36m\002\$(_hewitt_rel_pwd)\001\033[0m\002]\$(_hewitt_git_branch) \$ '

if [ -f "$profile_home/.bashrc" ]; then
	. "$profile_home/.bashrc"
fi
if [ -d "$profile_home/.bashrc.d" ]; then
	for rc in "$profile_home/.bashrc.d"/*; do
		if [ -f "\$rc" ]; then
			. "\$rc"
		fi
	done
	unset rc
fi
if [ -f "$profile_home/.gitconfig" ]; then
	export GIT_CONFIG_GLOBAL="$profile_home/.gitconfig"
fi


detach() {
	if [ -z "\$TMUX" ]; then
		printf 'hewitt: no tmux session to detach\n' >&2
		return 1
	fi
	command tmux detach-client
}
if [ "\${HEWITT_HOST_TERMINAL:-}" = "1" ]; then
	printf 'hewitt: exit or Ctrl-D closes this shell; use host tmux to detach. Ctrl-C cancels the current command.\n'
else
	printf 'hewitt: type detach to return to the host (session stays running); exit or Ctrl-D closes this shell. Ctrl-C cancels the current command.\n'
fi

cd() {
	local target="\${1:-\$HEWITT_PROJECT_ROOT}"
	if [ "\$target" = "-" ]; then
		target="\${OLDPWD:-\$HEWITT_PROJECT_ROOT}"
	fi
	local resolved
	if ! resolved="\$(realpath -m -- "\$target" 2>/dev/null)"; then
		builtin cd "\$@"
		return \$?
	fi
	if [ "\$resolved" != "\$HEWITT_PROJECT_ROOT" ] && [[ "\$resolved" != "\$HEWITT_PROJECT_ROOT/"* ]]; then
		printf 'hewitt: shell is restricted to project directory (%s)\n' "\$HEWITT_PROJECT_NAME" >&2
		return 1
	fi
	builtin cd "\$resolved"
}

pushd() {
	printf 'hewitt: pushd is disabled in project shell\n' >&2
	return 1
}

popd() {
	printf 'hewitt: popd is disabled in project shell\n' >&2
	return 1
}
EOF
	exec bash --rcfile "$rcfile" -i
}

pick_interactive() {
	local dir_name
	dir_name="${HEWITT_PROJECT_NAME:-$(basename "$PWD")}"
	local -a names descs
	read -r -a names <<<"${HEWITT_AGENTS:-}"
	names+=("shell")
	local i
	for ((i = 0; i < ${#names[@]} - 1; i++)); do descs+=("new branch"); done
	descs+=("$dir_name")
	local selected=0
	local count=${#names[@]}
	local total_lines=$((count + 1))

	draw_menu() {
		local redraw="${1:-0}"
		if [ "$redraw" = "1" ]; then
			printf '\033[%dA\r\033[J' "$total_lines" >&2
		fi
		printf '%s \033[2m(↑/↓ or 1-%d, enter to select, q to close)\033[0m\r\n' "$dir_name" "$((count < 9 ? count : 9))" >&2
		local i
		for ((i = 0; i < count; i++)); do
			if [ "$i" -eq "$selected" ]; then
				printf '  \033[1;36m> %d) %-10s\033[0m \033[2m(%s)\033[0m\r\n' "$((i + 1))" "${names[$i]}" "${descs[$i]}" >&2
			else
				printf '    \033[2m%d) %-10s (%s)\033[0m\r\n' "$((i + 1))" "${names[$i]}" "${descs[$i]}" >&2
			fi
		done
	}

	draw_menu 0
	while IFS= read -rsn1 key; do
		case "$key" in
		"")
			break
			;;
		q | Q)
			exit 0
			;;
		k | K)
			if [ "$selected" -gt 0 ]; then
				selected=$((selected - 1))
				draw_menu 1
			fi
			;;
		j | J)
			if [ "$selected" -lt $((count - 1)) ]; then
				selected=$((selected + 1))
				draw_menu 1
			fi
			;;
		[1-9])
			if [ "$key" -le "$count" ]; then
				selected=$((key - 1))
				draw_menu 1
				break
			fi
			;;
		$'\x1b')
			IFS= read -rsn2 -t 0.1 rest || true
			case "$rest" in
			"[A")
				if [ "$selected" -gt 0 ]; then
					selected=$((selected - 1))
					draw_menu 1
				fi
				;;
			"[B")
				if [ "$selected" -lt $((count - 1)) ]; then
					selected=$((selected + 1))
					draw_menu 1
				fi
				;;
			esac
			;;
		esac
	done

	printf '\033[%dA\r\033[J' "$total_lines" >&2
	printf '%s\n' "${names[$selected]}"
}

load_tmux_conf() {
	if ! command -v tmux >/dev/null 2>&1 || [ -z "${TMUX:-}" ]; then
		return 0
	fi
	tmux set-option -g default-terminal "tmux-256color" \; \
		set-option -ga terminal-overrides ",*256col*:Tc,xterm*:Tc,screen*:Tc,tmux*:Tc" \; \
		set-option -as terminal-features ",*:RGB" \; \
		set-option -g allow-passthrough on \; \
		set-environment -g COLORTERM "truecolor" \; \
		set-option -g mouse on 2>/dev/null || true
	local conf
	for conf in \
		"${HEWITT_PROFILES_DIR:-/hewitt/profiles}/claude/home/.tmux.conf" \
		"${HEWITT_PROFILES_DIR:-/hewitt/profiles}/claude/config/tmux/tmux.conf" \
		"/hewitt/profile/home/.tmux.conf" \
		"/hewitt/profile/config/tmux/tmux.conf"; do
		if [ -f "$conf" ]; then
			tmux source-file "$conf" 2>/dev/null || true
			break
		fi
	done
	# Preserve imported styling and keybindings. Only the new-window launcher
	# is owned by Hewitt after loading the user configuration.
	tmux set-option -g default-command "$SELF" 2>/dev/null || true
}

cmd="${1:-}"
if [ "${HEWITT_HOST_TERMINAL:-}" != "1" ]; then load_tmux_conf; fi
case "$cmd" in
install)
	# Hewitt's installer container: the only writer of the tool cache.
	install_tool 2>&1
	;;
launch)
	# Authentication containers and legacy terminals: the launch as given.
	launch_args
	exec_launch
	;;
slash)
	slash
	;;
run | "")
	# hewitt-agent run <agent> opens the agent Hewitt chose with HEWITT_LAUNCH;
	# without one, it asks which agent of the workspace to open.
	[ "$cmd" = run ] && shift
	choice="${1:-}"
	menu=""
	if [ -z "$choice" ]; then
		choice="$(pick_interactive)"
		menu="$choice"
	fi
	if [ "$choice" = "shell" ]; then
		exec_shell
	fi
	create_worktree_if_needed
	if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
		tmux rename-window "$choice:${HEWITT_PROJECT_NAME:-$(basename "$HEWITT_REPO")}" 2>/dev/null || true
	fi
	launch_args "$menu"
	exec_launch
	;;
*)
	printf 'Unknown hewitt-agent command: %s\n' "$cmd" >&2
	exit 2
	;;
esac
