#!/usr/bin/env bash
set -euo pipefail

export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
if [ -z "${TERM:-}" ] || [ "${TERM:-}" = "screen" ] || [ "${TERM:-}" = "dumb" ]; then
	export TERM=xterm-256color
fi
export COLORTERM="${COLORTERM:-truecolor}"

TOOLS_DIR="${HEWITT_TOOLS_DIR:-/hewitt/tools}"
BIN_DIR="$TOOLS_DIR/bin"
export PATH="$BIN_DIR:$PATH"

# Sessions run as the host UID, which the image usually lacks; ssh refuses to
# run without a passwd entry. nss_wrapper supplies one without touching /etc.
if ! getent passwd "$(id -u)" >/dev/null 2>&1 && [ -z "${NSS_WRAPPER_PASSWD:-}" ]; then
	NSS_WRAPPER_PASSWD="$(mktemp /tmp/hewitt-passwd.XXXXXX)"
	NSS_WRAPPER_GROUP="$(mktemp /tmp/hewitt-group.XXXXXX)"
	cat /etc/passwd >"$NSS_WRAPPER_PASSWD"
	printf 'hewitt:x:%s:%s:Hewitt:%s:/bin/bash\n' "$(id -u)" "$(id -g)" "${HOME:-/tmp}" >>"$NSS_WRAPPER_PASSWD"
	cat /etc/group >"$NSS_WRAPPER_GROUP"
	getent group "$(id -g)" >/dev/null 2>&1 || printf 'hewitt:x:%s:\n' "$(id -g)" >>"$NSS_WRAPPER_GROUP"
	export NSS_WRAPPER_PASSWD NSS_WRAPPER_GROUP LD_PRELOAD="libnss_wrapper.so${LD_PRELOAD:+ $LD_PRELOAD}"
fi

# agent_binary maps an agent name to its executable.
agent_binary() {
	case "$1" in
	antigravity) printf 'agy\n' ;;
	*) printf '%s\n' "$1" ;;
	esac
}

ensure_agent() {
	local agent
	agent="$(agent_binary "$1")"
	mkdir -p "$BIN_DIR"
	if [ -x "$BIN_DIR/$agent" ]; then
		return 0
	fi
	if [ -x "$TOOLS_DIR/$agent/node_modules/.bin/$agent" ]; then
		ln -sf "$TOOLS_DIR/$agent/node_modules/.bin/$agent" "$BIN_DIR/$agent"
		return 0
	fi
	if command -v "$agent" >/dev/null 2>&1; then
		return 0
	fi
	printf 'Installing %s...\n' "$agent" >&2
	case "$agent" in
	claude)
		local version="${CLAUDE_VERSION:-stable}"
		local tmp
		tmp="$(mktemp -d)"
		curl -fsSL https://claude.ai/install.sh -o "$tmp/install-claude.sh"
		HOME="$tmp" bash "$tmp/install-claude.sh" "$version" >&2
		cp -L "$tmp/.local/bin/claude" "$BIN_DIR/claude"
		chmod 0755 "$BIN_DIR/claude"
		rm -rf "$tmp"
		;;
	codex)
		local version="${CODEX_VERSION:-latest}"
		npm install --prefix "$TOOLS_DIR/codex" "@openai/codex@$version" >&2
		ln -sf "$TOOLS_DIR/codex/node_modules/.bin/codex" "$BIN_DIR/codex"
		;;
	opencode)
		local version="${OPENCODE_VERSION:-latest}"
		npm install --prefix "$TOOLS_DIR/opencode" "opencode-ai@$version" >&2
		ln -sf "$TOOLS_DIR/opencode/node_modules/.bin/opencode" "$BIN_DIR/opencode"
		;;
	pi)
		local version="${PI_VERSION:-latest}"
		npm install --prefix "$TOOLS_DIR/pi" --ignore-scripts "@earendil-works/pi-coding-agent@$version" >&2
		ln -sf "$TOOLS_DIR/pi/node_modules/.bin/pi" "$BIN_DIR/pi"
		;;
	agy)
		local tmp
		tmp="$(mktemp -d)"
		curl -fsSL https://antigravity.google/cli/install.sh -o "$tmp/install-agy.sh"
		HOME="$tmp" bash "$tmp/install-agy.sh" --dir "$BIN_DIR" >&2
		rm -rf "$tmp"
		;;
	*)
		printf 'Unsupported agent: %s\n' "$agent" >&2
		return 1
		;;
	esac
}

# launch execs an installed binary. agy stores its login in the Secret Service
# keyring, so it runs in a private D-Bus session with gnome-keyring. The keyring
# file lives in XDG_DATA_HOME, inside the private profile, which is what protects
# it; the fixed password only lets the daemon create and unlock it without a
# graphical prompt.
launch() {
	local binary="$1"
	shift
	if [ "$binary" != "agy" ]; then
		exec "$binary" "$@"
	fi
	mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/keyrings"
	exec dbus-run-session -- bash -c 'printf hewitt | gnome-keyring-daemon --replace --unlock --components=secrets >/dev/null 2>&1; exec agy "$@"' agy "$@"
}

# slash starts an agent in a private tmux server, types one of its slash
# commands (such as /login) once the screen settles, and attaches to it, for
# agents whose login exists only inside their interface.
slash() {
	local binary="$1" command="$2" socket="/tmp/hewitt-slash-$$.sock"
	ensure_agent "$binary"
	tmux -u -f /dev/null -S "$socket" new-session -d -s slash -x "$(tput cols 2>/dev/null || echo 120)" -y "$(tput lines 2>/dev/null || echo 40)" -- hewitt-agent "$binary"
	# Wait until the screen has been unchanged for a second (startup finished).
	local previous="" current i stable=0
	for ((i = 0; i < 240 && stable < 2; i++)); do
		sleep 0.5
		current="$(tmux -S "$socket" capture-pane -p -t slash 2>/dev/null)" || exit 1
		if [ -n "${current//[[:space:]]/}" ] && [ "$current" = "$previous" ]; then
			stable=$((stable + 1))
		else
			stable=0
		fi
		previous="$current"
	done
	# Typing a command opens completion; the first Enter may only pick the
	# completion, so press it again while the command is still in the editor.
	tmux -S "$socket" send-keys -t slash -l "$command"
	for ((i = 0; i < 3; i++)); do
		sleep 0.5
		tmux -S "$socket" send-keys -t slash Enter
		sleep 1
		tmux -S "$socket" capture-pane -p -t slash 2>/dev/null | grep -qx "[[:space:]]*$command[[:space:]]*" || break
	done
	exec env -u TMUX tmux -u -S "$socket" attach-session -t slash
}

create_worktree_if_needed() {
	if [ "${HEWITT_WORKSPACE_MODE:-worktree}" != "worktree" ]; then
		return 0
	fi
	if [ -n "${HEWITT_INITIAL_WORKTREE_READY:-}" ]; then
		unset HEWITT_INITIAL_WORKTREE_READY
		return 0
	fi
	if [ -z "${HEWITT_REPO:-}" ] || [ -z "${HEWITT_WORKTREES_DIR:-}" ]; then
		return 0
	fi
	local wt_path branch base="${HEWITT_BASE:-HEAD}"
	local label="${choice:-agent}" n=1
	while :; do
		branch="$label-$n"
		wt_path="$HEWITT_WORKTREES_DIR/$branch"
		if [ ! -e "$wt_path" ] && ! git -C "$HEWITT_REPO" show-ref --verify --quiet "refs/heads/$branch"; then
			break
		fi
		n=$((n + 1))
	done
	mkdir -p "$HEWITT_WORKTREES_DIR"
	git -C "$HEWITT_REPO" worktree add -b "$branch" -- "$wt_path" "$base" >&2
	local target="$wt_path"
	if [ -n "${HEWITT_SUBDIR:-}" ] && [ "$HEWITT_SUBDIR" != "." ]; then
		target="$wt_path/$HEWITT_SUBDIR"
	fi
	cd "$target"
}

exec_agent() {
	local agent="$1"
	shift
	ensure_agent "$agent"
	local profile_root="${HEWITT_PROFILES_DIR:-/hewitt/profiles}/$agent"
	if [ ! -d "$profile_root" ] && [ -d "/hewitt/profile" ]; then
		profile_root="/hewitt/profile"
	fi
	export HOME="$profile_root/home"
	export XDG_CONFIG_HOME="$profile_root/config"
	export XDG_DATA_HOME="$profile_root/data"
	export XDG_STATE_HOME="$profile_root/state"
	export XDG_CACHE_HOME="$profile_root/cache"
	mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME" "$profile_root/$agent" 2>/dev/null || true

	if [ -f "$profile_root/token.env" ]; then
		set -a
		# shellcheck disable=SC1090
		. "$profile_root/token.env"
		set +a
	fi

	# Wait briefly for the tmux client to attach so terminal background/palette
	# queries (OSC 10/11 via tmux passthrough) reach the host terminal.
	if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
		local tries=0
		while [ "$tries" -lt 20 ] && [ -z "$(tmux list-clients 2>/dev/null)" ]; do
			sleep 0.05
			tries=$((tries + 1))
		done
	fi

	case "$agent" in
	claude)
		export CLAUDE_CONFIG_DIR="$profile_root/claude"
		export DISABLE_AUTOUPDATER=1
		exec env \
			-u ANTHROPIC_API_KEY \
			-u ANTHROPIC_AUTH_TOKEN \
			-u ANTHROPIC_BASE_URL \
			-u CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR \
			-u CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR \
			-u CLAUDE_CODE_USE_BEDROCK \
			-u CLAUDE_CODE_USE_VERTEX \
			-u CLAUDE_CODE_USE_FOUNDRY \
			claude "$@"
		;;
	codex)
		export CODEX_HOME="$profile_root/codex"
		exec env \
			-u OPENAI_API_KEY \
			-u CODEX_API_KEY \
			-u CODEX_ACCESS_TOKEN \
			-u OPENAI_BASE_URL \
			-u OPENAI_IDENTITY_TOKEN_FILE \
			-u OPENAI_WORKLOAD_IDENTITY_PROVIDER \
			codex -c 'cli_auth_credentials_store="file"' -c 'forced_login_method="chatgpt"' -c "projects.\"$PWD\".trust_level=\"trusted\"" "$@"
		;;
	opencode)
		export OPENCODE_DISABLE_AUTOUPDATE=1
		exec env \
			-u OPENCODE_DISABLE_DEFAULT_PLUGINS \
			-u OPENCODE_CONFIG \
			-u OPENCODE_CONFIG_CONTENT \
			opencode "$@"
		;;
	pi)
		export PI_CODING_AGENT_DIR="$profile_root/pi" PI_SKIP_VERSION_CHECK=1
		launch pi "$@"
		;;
	antigravity)
		launch agy "$@"
		;;
	*)
		printf 'Unsupported agent: %s\n' "$agent" >&2
		exit 1
		;;
	esac
}

exec_shell() {
	local dir_name project_root rcfile profile_home
	dir_name="${HEWITT_PROJECT_NAME:-$(basename "$PWD")}"
	project_root="$(realpath "$PWD")"
	profile_home="${HEWITT_PROFILES_DIR:-/hewitt/profiles}/claude/home"
	if [ ! -d "$profile_home" ] && [ -d "/hewitt/profile/home" ]; then
		profile_home="/hewitt/profile/home"
	fi
	if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
		tmux rename-window "shell:$dir_name" 2>/dev/null || true
	fi
	rcfile="$(mktemp /tmp/hewitt-bashrc.XXXXXX)"
	cat >"$rcfile" <<EOF
rm -f "$rcfile"
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export LESS='-R'
if [ -f /etc/bash.bashrc ]; then
	. /etc/bash.bashrc
fi
if [ -f /usr/share/bash-completion/bash_completion ]; then
	. /usr/share/bash-completion/bash_completion
fi
if command -v dircolors >/dev/null 2>&1; then
	eval "\$(dircolors -b)"
fi
export HEWITT_PROJECT_ROOT="$project_root"
export HEWITT_PROJECT_NAME="$dir_name"
export HOME="\$HEWITT_PROJECT_ROOT"
bind 'set input-meta on' 2>/dev/null || true
bind 'set output-meta on' 2>/dev/null || true
bind 'set convert-meta off' 2>/dev/null || true

alias ls='ls --color=auto'
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'

_hewitt_rel_pwd() {
	if [ "\$PWD" = "\$HEWITT_PROJECT_ROOT" ]; then
		printf '%s' "\$HEWITT_PROJECT_NAME"
	elif [[ "\$PWD" == "\$HEWITT_PROJECT_ROOT/"* ]]; then
		printf '%s/%s' "\$HEWITT_PROJECT_NAME" "\${PWD#"\$HEWITT_PROJECT_ROOT/"}"
	else
		printf '%s' "\$(basename "\$PWD")"
	fi
}

_hewitt_git_branch() {
	local br
	br="\$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)" || return 0
	if [ -n "\$br" ]; then
		printf ' (\001\033[33m\002%s\001\033[0m\002)' "\$br"
	fi
}

PS1='[\001\033[1;36m\002\$(_hewitt_rel_pwd)\001\033[0m\002]\$(_hewitt_git_branch) \$ '

if [ -f "$profile_home/.bashrc" ]; then
	. "$profile_home/.bashrc"
fi
if [ -d "$profile_home/.bashrc.d" ]; then
	for rc in "$profile_home/.bashrc.d"/*; do
		if [ -f "\$rc" ]; then
			. "\$rc"
		fi
	done
	unset rc
fi
if [ -f "$profile_home/.gitconfig" ]; then
	export GIT_CONFIG_GLOBAL="$profile_home/.gitconfig"
fi


detach() {
	if [ -z "\$TMUX" ]; then
		printf 'hewitt: no tmux session to detach\n' >&2
		return 1
	fi
	command tmux detach-client
}
printf 'hewitt: type detach to return to the host (session stays running); exit or Ctrl-D closes this shell. Ctrl-C cancels the current command.\n'

cd() {
	local target="\${1:-\$HEWITT_PROJECT_ROOT}"
	if [ "\$target" = "-" ]; then
		target="\${OLDPWD:-\$HEWITT_PROJECT_ROOT}"
	fi
	local resolved
	if ! resolved="\$(realpath -m -- "\$target" 2>/dev/null)"; then
		builtin cd "\$@"
		return \$?
	fi
	if [ "\$resolved" != "\$HEWITT_PROJECT_ROOT" ] && [[ "\$resolved" != "\$HEWITT_PROJECT_ROOT/"* ]]; then
		printf 'hewitt: shell is restricted to project directory (%s)\n' "\$HEWITT_PROJECT_NAME" >&2
		return 1
	fi
	builtin cd "\$resolved"
}

pushd() {
	printf 'hewitt: pushd is disabled in project shell\n' >&2
	return 1
}

popd() {
	printf 'hewitt: popd is disabled in project shell\n' >&2
	return 1
}
EOF
	exec bash --rcfile "$rcfile" -i
}

pick_interactive() {
	local dir_name
	dir_name="${HEWITT_PROJECT_NAME:-$(basename "$PWD")}"
	local names=("claude" "codex" "opencode" "pi" "antigravity" "shell")
	local descs=("new branch" "new branch" "new branch" "new branch" "new branch" "$dir_name")
	local selected=0
	local count=${#names[@]}
	local total_lines=$((count + 1))

	draw_menu() {
		local redraw="${1:-0}"
		if [ "$redraw" = "1" ]; then
			printf '\033[%dA\r\033[J' "$total_lines" >&2
		fi
		printf '%s \033[2m(↑/↓ or 1-4, enter to select, q to close)\033[0m\r\n' "$dir_name" >&2
		local i
		for ((i = 0; i < count; i++)); do
			if [ "$i" -eq "$selected" ]; then
				printf '  \033[1;36m> %d) %-10s\033[0m \033[2m(%s)\033[0m\r\n' "$((i + 1))" "${names[$i]}" "${descs[$i]}" >&2
			else
				printf '    \033[2m%d) %-10s (%s)\033[0m\r\n' "$((i + 1))" "${names[$i]}" "${descs[$i]}" >&2
			fi
		done
	}

	draw_menu 0
	while IFS= read -rsn1 key; do
		case "$key" in
		"")
			break
			;;
		q | Q)
			exit 0
			;;
		k | K)
			if [ "$selected" -gt 0 ]; then
				selected=$((selected - 1))
				draw_menu 1
			fi
			;;
		j | J)
			if [ "$selected" -lt $((count - 1)) ]; then
				selected=$((selected + 1))
				draw_menu 1
			fi
			;;
		[1-6])
			selected=$((key - 1))
			draw_menu 1
			break
			;;
		$'\x1b')
			IFS= read -rsn2 -t 0.1 rest || true
			case "$rest" in
			"[A")
				if [ "$selected" -gt 0 ]; then
					selected=$((selected - 1))
					draw_menu 1
				fi
				;;
			"[B")
				if [ "$selected" -lt $((count - 1)) ]; then
					selected=$((selected + 1))
					draw_menu 1
				fi
				;;
			esac
			;;
		esac
	done

	printf '\033[%dA\r\033[J' "$total_lines" >&2
	printf '%s\n' "${names[$selected]}"
}

load_tmux_conf() {
	if ! command -v tmux >/dev/null 2>&1 || [ -z "${TMUX:-}" ]; then
		return 0
	fi
	tmux set-option -g default-terminal "tmux-256color" \; \
		set-option -ga terminal-overrides ",*256col*:Tc,xterm*:Tc,screen*:Tc,tmux*:Tc" \; \
		set-option -as terminal-features ",*:RGB" \; \
		set-option -g allow-passthrough on \; \
		set-environment -g COLORTERM "truecolor" \; \
		set-option -g mouse on 2>/dev/null || true
	local conf
	for conf in \
		"${HEWITT_PROFILES_DIR:-/hewitt/profiles}/claude/home/.tmux.conf" \
		"${HEWITT_PROFILES_DIR:-/hewitt/profiles}/claude/config/tmux/tmux.conf" \
		"/hewitt/profile/home/.tmux.conf" \
		"/hewitt/profile/config/tmux/tmux.conf"; do
		if [ -f "$conf" ]; then
			tmux source-file "$conf" 2>/dev/null || true
			break
		fi
	done
	# Preserve imported styling and keybindings. Only the new-window launcher
	# is owned by Hewitt after loading the user configuration.
	tmux set-option -g default-command hewitt-agent 2>/dev/null || true
}

cmd="${1:-}"
load_tmux_conf
case "$cmd" in
ensure)
	shift
	agent="$1"
	shift
	ensure_agent "$agent"
	launch "$(agent_binary "$agent")" "$@"
	;;
slash)
	shift
	slash "$@"
	;;
run)
	shift
	choice="${1:-}"
	if [ -z "$choice" ]; then
		choice="$(pick_interactive)"
	fi
	if [ "$choice" = "shell" ]; then
		exec_shell
	fi
	create_worktree_if_needed
	if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
		tmux rename-window "$choice:${HEWITT_PROJECT_NAME:-$(basename "$HEWITT_REPO")}" 2>/dev/null || true
	fi
	exec_agent "$choice"
	;;
"")
	choice="$(pick_interactive)"
	if [ "$choice" = "shell" ]; then
		exec_shell
	fi
	create_worktree_if_needed
	if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
		tmux rename-window "$choice:${HEWITT_PROJECT_NAME:-$(basename "$HEWITT_REPO")}" 2>/dev/null || true
	fi
	exec_agent "$choice"
	;;
*)
	ensure_agent "$cmd"
	shift
	if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
		tries=0
		while [ "$tries" -lt 20 ] && [ -z "$(tmux list-clients 2>/dev/null)" ]; do
			sleep 0.05
			tries=$((tries + 1))
		done
	fi
	launch "$(agent_binary "$cmd")" "$@"
	;;
esac
